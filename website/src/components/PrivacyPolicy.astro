---
import type { Translations } from "../i18n/index.ts";
interface Props { t: Translations }
const { t } = Astro.props;
const p = t.privacyPolicy;
---

<article class="policy">
  <div class="wrap">
    <div class="policy-inner">
      <header class="policy-header">
        <p class="label">{p.eyebrow}</p>
        <h1 class="policy-title">{p.title}</h1>
        <p class="policy-updated">{p.updated}</p>
      </header>

      {p.intro.map((para) => <p class="policy-intro">{para}</p>)}

      {
        p.sections.map((s) => (
          <section class="policy-section">
            <h2>{s.heading}</h2>
            {s.body.map((para) => <p>{para}</p>)}
            {s.list.length > 0 && (
              <ul>
                {s.list.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </section>
        ))
      }

      <p class="policy-source">
        <a href="https://github.com/seriaati/keni" target="_blank" rel="noopener" class="text-link">github.com/seriaati/keni</a>
      </p>
    </div>
  </div>
</article>

<style>
  .policy {
    padding-top: clamp(56px, 8vw, 104px);
  }

  .policy-inner {
    max-width: 700px;
  }

  .policy-header {
    margin-bottom: clamp(36px, 5vw, 52px);
  }

  .policy-title {
    margin-top: 16px;
    font-family: var(--f-serif);
    font-size: clamp(48px, 6vw, 72px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.005em;
    color: var(--ink);
    text-wrap: balance;
  }

  .policy-updated {
    margin-top: 18px;
    font: 400 13px/1.4 var(--f-mono);
    color: var(--mute);
  }

  .policy-intro {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-mid);
  }

  .policy-intro + .policy-intro {
    margin-top: 16px;
  }

  .policy-section {
    margin-top: 48px;
  }

  .policy-section h2 {
    font-family: var(--f-serif);
    font-size: 27px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
    color: var(--ink);
    text-wrap: balance;
    margin-bottom: 14px;
  }

  .policy-section p,
  .policy-section li {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-mid);
  }

  .policy-section p + p {
    margin-top: 14px;
  }

  .policy-section ul {
    list-style: none;
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .policy-section li {
    position: relative;
    padding-left: 22px;
  }

  .policy-section li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: calc(0.85em - 3px);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
  }

  .policy-source {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }

  :lang(zh-TW) .policy-title,
  :lang(zh-TW) .policy-section h2 {
    letter-spacing: 0;
  }
</style>
