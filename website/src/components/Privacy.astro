---
import type { Translations } from "../i18n/index.ts";
interface Props { t: Translations }
const { t } = Astro.props;
const p = t.privacy;
---

<section class="privacy" id="privacy">
  <div class="wrap">
    <header class="privacy-head reveal">
      <p class="label">{p.label}</p>
      <h2 class="privacy-title">{p.title}</h2>
      <p class="privacy-sub">{p.sub}</p>
    </header>

    <div class="privacy-body reveal">
      <ul class="check-list">
        {
          p.checklist.map((item) => (
            <li>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.25"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>

      <figure class="code">
        <figcaption class="label code-caption">{p.codeFilename}</figcaption>
        <pre
          class="code-body"><code><span class="c-key">services</span><span class="c-punc">:</span>
  <span class="c-key">keni</span><span class="c-punc">:</span>
    <span class="c-key">image</span><span class="c-punc">:</span> <span class="c-str">ghcr.io/seriaati/keni:latest</span>
    <span class="c-key">environment</span><span class="c-punc">:</span>
      <span class="c-key">DATABASE_URL</span><span class="c-punc">:</span> <span class="c-str">postgresql://...</span>
      <span class="c-key">STT_PROVIDER</span><span class="c-punc">:</span> <span class="c-str">"local"</span>
    <span class="c-key">ports</span><span class="c-punc">:</span>
      <span class="c-punc">-</span> <span class="c-str">"8000:8000"</span></code></pre>
      </figure>
    </div>
  </div>
</section>

<style>
  .privacy {
    padding-top: clamp(96px, 12vw, 160px);
  }

  .privacy-title {
    margin-top: 16px;
    font-size: clamp(30px, 3.6vw, 42px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.028em;
    color: var(--ink);
    text-wrap: balance;
    max-width: 20ch;
  }

  .privacy-sub {
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--mute);
    max-width: 60ch;
    text-wrap: pretty;
  }

  .privacy-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .check-list {
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .check-list li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-block: 16px;
    border-bottom: 1px solid var(--rule);
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
  }

  .check-list svg {
    flex-shrink: 0;
    color: var(--amber);
    transform: translateY(2px);
  }

  .code {
    min-width: 0;
  }

  .code-caption {
    display: block;
    margin-bottom: 10px;
  }

  .code-body {
    background: var(--paper-2);
    border-radius: var(--radius);
    padding: 22px 24px;
    font: 400 13px/1.8 var(--f-mono);
    color: var(--ink);
    overflow-x: auto;
  }

  .code-body code {
    display: block;
    font: inherit;
  }

  .c-key { color: var(--ink); }
  .c-punc { color: var(--mute); }
  .c-str { color: var(--amber-text); }

  :lang(zh-TW) .privacy-title {
    letter-spacing: 0;
  }

  @media (max-width: 860px) {
    .privacy-body {
      grid-template-columns: 1fr;
    }
  }
</style>
