---
// Voice input demo: a recording waveform shaped by the transcript itself is "heard", then swept into the
// words it came from, which are then glossed like the other examples.
import type { Translations } from "../i18n/index.ts";

type CaptureItem = Translations["features"]["capture"]["items"][number];
interface Props {
  item: CaptureItem;
}

const { item } = Astro.props;
const ex = item.example;
const duration = item.duration ?? "0:03";
---

{ex && (
  <div class="vd" data-voice-demo data-example={JSON.stringify(ex)} data-duration={duration}>
    <div class="vd-meta" aria-hidden="true">
      <svg class="vd-mic" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <rect x="5.5" y="1.75" width="5" height="8" rx="2.5" />
        <path d="M3.25 7.5a4.75 4.75 0 0 0 9.5 0M8 12.25v2" />
      </svg>
      <span class="vd-time">{duration}</span>
    </div>
    <div class="gloss gloss--sm vd-gloss">
      <div class="vd-stage">
        <div class="gloss-line">{ex.text}</div>
        <div class="vd-wave" aria-hidden="true"></div>
        <div class="vd-edge" aria-hidden="true"></div>
      </div>
      <div class="gloss-notes" aria-hidden="true"></div>
    </div>
  </div>
)}

<script>
  import { Gloss, reduced, type GlossExample } from "../scripts/gloss.ts";

  const PITCH = 4.5; // 2px bar + 2.5px gap
  const LISTEN = 1600;
  const RECORD = 1150; // the record head crosses the line within the listening phase
  const SWEEP = 1100;
  const COLLAPSE = 300;
  const SOFT = 28; // soft edge of the text reveal, px

  const easeOut = (p: number) => 1 - Math.pow(1 - p, 3);
  const easeInOut = (p: number) => (p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2);

  /** Deterministic PRNG seeded by the transcript, so the same words always make the same waveform. */
  function rng(text: string) {
    let h = 2166136261;
    for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619);
    return () => {
      h = (h + 0x6d2b79f5) | 0;
      let t = Math.imul(h ^ (h >>> 15), 1 | h);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  const SILENT = /[\s\p{P}\p{S}]/u;
  const SYLLABLE = /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]/u;

  interface Bar {
    el: HTMLElement;
    x: number;
    a: number; // resting amplitude, 0..1
    w: number; // breathing speed
    ph: number; // breathing phase
  }

  function fmtTime(s: number) {
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
  }

  function init(root: HTMLElement) {
    const ex = JSON.parse(root.dataset.example ?? "{}") as GlossExample;
    const total = (root.dataset.duration ?? "0:03").split(":").reduce((acc, n) => acc * 60 + (parseInt(n, 10) || 0), 0);
    const glossEl = root.querySelector<HTMLElement>(".vd-gloss")!;
    const line = root.querySelector<HTMLElement>(".gloss-line")!;
    const wave = root.querySelector<HTMLElement>(".vd-wave")!;
    const edge = root.querySelector<HTMLElement>(".vd-edge")!;
    const notesEl = root.querySelector<HTMLElement>(".gloss-notes")!;
    const time = root.querySelector<HTMLElement>(".vd-time")!;
    const g = new Gloss(glossEl, 14);
    let placed: ReturnType<Gloss["paint"]> = [];
    let bars: Bar[] = [];
    let width = 0;
    let raf = 0;
    let state: "armed" | "playing" | "done" = "armed";

    /** Paint the line, reserve the notes' final height, and shape a bar for every 4.5px of laid-out text. */
    const layout = () => {
      placed = g.paint(ex.text, ex.notes);
      g.annotate(placed, false);
      const reserved = notesEl.style.height;
      notesEl.textContent = "";
      notesEl.style.height = reserved;

      // Where each character sits, and which word or syllable it belongs to.
      const box = line.getBoundingClientRect();
      const chars: { s: number; e: number; c: string; seg: number }[] = [];
      const walker = document.createTreeWalker(line, NodeFilter.SHOW_TEXT);
      const range = document.createRange();
      let seg = 0;
      let prevWord = false;
      for (let n = walker.nextNode(); n; n = walker.nextNode()) {
        const text = n.textContent ?? "";
        for (let i = 0; i < text.length; i++) {
          range.setStart(n, i);
          range.setEnd(n, i + 1);
          const r = range.getBoundingClientRect();
          const c = text[i];
          const silent = SILENT.test(c);
          const syl = SYLLABLE.test(c);
          // Latin words are one burst each; every CJK character is its own syllable.
          if (silent || syl || !prevWord) seg++;
          prevWord = !silent && !syl;
          chars.push({ s: r.left - box.left, e: r.right - box.left, c, seg });
        }
      }
      width = chars.length ? chars[chars.length - 1].e : 0;
      const segs = new Map<number, { s: number; e: number }>();
      for (const ch of chars) {
        const b = segs.get(ch.seg);
        segs.set(ch.seg, b ? { s: Math.min(b.s, ch.s), e: Math.max(b.e, ch.e) } : { s: ch.s, e: ch.e });
      }

      const rand = rng(ex.text);
      const charGain = chars.map(() => 0.6 + rand() * 0.4);
      const height = Math.round(parseFloat(getComputedStyle(line).fontSize) * 1.05);
      const count = Math.max(1, Math.floor((width + 2.5) / PITCH));
      wave.textContent = "";
      wave.style.height = `${height}px`;
      bars = [];
      for (let i = 0; i < count; i++) {
        const x = i * PITCH + 1;
        const k = chars.findIndex((ch) => x < ch.e);
        const ch = chars[k === -1 ? chars.length - 1 : k];
        let a = 0.05 + rand() * 0.05;
        if (ch && !SILENT.test(ch.c)) {
          const sg = segs.get(ch.seg)!;
          const u = (x - sg.s) / Math.max(1, sg.e - sg.s);
          const env = Math.pow(Math.sin(Math.PI * Math.min(1, Math.max(0, u))), 0.7);
          a = Math.max(0.12, Math.min(1, (0.1 + 0.9 * env) * charGain[k] * (0.72 + rand() * 0.28)));
        }
        const el = document.createElement("i");
        wave.append(el);
        bars.push({ el, x, a, w: 0.006 + rand() * 0.008, ph: rand() * Math.PI * 2 });
      }
    };

    const arm = () => {
      cancelAnimationFrame(raf);
      root.classList.remove("is-listening", "is-transcribing", "is-done");
      root.classList.add("is-armed");
      line.style.setProperty("--edge", "0px");
      notesEl.textContent = "";
      for (const b of bars) {
        b.el.style.transform = "scaleY(0.06)";
        b.el.style.opacity = "0.55";
      }
      time.textContent = fmtTime(0);
      state = "armed";
    };

    const finish = (animate: boolean) => {
      cancelAnimationFrame(raf);
      root.classList.remove("is-armed", "is-listening", "is-transcribing");
      root.classList.add("is-done");
      time.textContent = fmtTime(total);
      placed = g.paint(ex.text, ex.notes);
      g.annotate(placed, animate);
      state = "done";
    };

    const play = () => {
      state = "playing";
      root.classList.remove("is-armed");
      root.classList.add("is-listening");
      const passed = new Map<Bar, number>();
      const t0 = performance.now();
      const step = (t: number) => {
        const dt = t - t0;
        if (dt < LISTEN) {
          // Listening: the record head draws the waveform in, recorded bars breathe around their height.
          const head = easeOut(Math.min(1, dt / RECORD)) * (width + 8);
          for (const b of bars) {
            const rise = Math.min(1, Math.max(0, (head - b.x) / 40));
            const breathe = 0.78 + 0.22 * Math.sin(dt * b.w + b.ph);
            b.el.style.transform = `scaleY(${Math.max(0.06, b.a * breathe * rise)})`;
            b.el.style.opacity = rise > 0 ? "1" : "0.55";
          }
          time.textContent = fmtTime(Math.min(total, Math.floor((total + 1) * Math.min(1, dt / (LISTEN - 120)))));
        } else if (dt < LISTEN + SWEEP + COLLAPSE) {
          // Transcribing: an edge sweeps right; sound behind it collapses as the words appear.
          if (!root.classList.contains("is-transcribing")) {
            root.classList.replace("is-listening", "is-transcribing");
            time.textContent = fmtTime(total);
          }
          const p = Math.min(1, (dt - LISTEN) / SWEEP);
          const x = easeInOut(p) * (width + SOFT);
          line.style.setProperty("--edge", `${x}px`);
          edge.style.transform = `translateX(${Math.min(x, width + 2)}px)`;
          for (const b of bars) {
            if (b.x <= x - 4 && !passed.has(b)) passed.set(b, t);
            const since = passed.get(b);
            const q = since === undefined ? 0 : Math.min(1, (t - since) / COLLAPSE);
            const breathe = 0.78 + 0.22 * Math.sin(dt * b.w + b.ph);
            const s = b.a * breathe * (1 - q) + 0.04 * q;
            b.el.style.transform = `scaleY(${s})`;
            b.el.style.opacity = String(1 - q);
          }
        } else {
          finish(true);
          return;
        }
        raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };

    root.classList.add("is-armed");

    document.fonts.ready.then(() => {
      layout();
      if (reduced()) {
        finish(false);
        return;
      }
      arm();
      root.classList.add("is-ready");

      new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) {
            if (state !== "armed") arm();
          } else if (e.intersectionRatio >= 0.5 && state === "armed") {
            play();
          }
        },
        { threshold: [0, 0.5] },
      ).observe(root);

      let lastWidth = window.innerWidth;
      let timer = 0;
      window.addEventListener("resize", () => {
        if (window.innerWidth === lastWidth) return;
        lastWidth = window.innerWidth;
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          const wasArmed = state === "armed";
          cancelAnimationFrame(raf);
          layout();
          if (wasArmed) arm();
          else finish(false);
        }, 120);
      });
    });
  }

  document.querySelectorAll<HTMLElement>("[data-voice-demo]").forEach(init);
</script>

<style>
  .vd {
    max-width: 100%;
  }
  .vd-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 18px;
    margin-bottom: 12px;
    font: 500 11.5px/1 var(--f-mono);
    letter-spacing: 0.06em;
    color: var(--mute);
    font-variant-numeric: tabular-nums;
  }
  .vd-mic {
    color: var(--mute);
    transition: color 0.3s ease;
  }
  .vd.is-listening .vd-mic {
    color: var(--amber);
    animation: vd-pulse 1.1s ease-in-out infinite;
  }
  .vd.is-listening .vd-time {
    color: var(--ink-mid);
  }
  @keyframes vd-pulse {
    50% {
      opacity: 0.4;
    }
  }

  .vd-stage {
    position: relative;
  }
  .vd-wave {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    display: flex;
    align-items: center;
    gap: 2.5px;
    translate: 0 -50%;
    pointer-events: none;
  }
  .vd-wave :global(i) {
    flex: none;
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: var(--ink-mid);
    transform: scaleY(0.06);
    will-change: transform;
  }
  .vd-edge {
    position: absolute;
    top: 0.1em;
    left: 0;
    width: 1.5px;
    height: 0.95em;
    font-size: var(--gs);
    background: var(--amber);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .vd.is-transcribing .vd-edge {
    opacity: 1;
  }

  /* Text stays hidden behind a soft-edged mask until the reveal edge passes it. */
  .vd.is-armed .gloss-line,
  .vd.is-listening .gloss-line,
  .vd.is-transcribing .gloss-line {
    -webkit-mask-image: linear-gradient(90deg, #000 calc(var(--edge, 0px) - 28px), #0000 var(--edge, 0px));
    mask-image: linear-gradient(90deg, #000 calc(var(--edge, 0px) - 28px), #0000 var(--edge, 0px));
  }
  .vd.is-done .vd-wave,
  .vd:not(.is-ready) .vd-wave {
    visibility: hidden;
  }

  /* Without JS: plain wrapping transcript, no reserved notes. */
  :global(html:not(.js)) .vd .gloss-line {
    white-space: normal;
  }
  :global(html:not(.js)) .vd .gloss-notes {
    display: none;
  }
</style>
