---
import type { Translations } from "../i18n/index.ts";
interface Props { t: Translations }
const { t } = Astro.props;
const c = t.cta;
---

<section class="cta" id="get-started">
  <div class="wrap reveal">
    <h2 class="cta-title">{c.title}</h2>
    <p class="cta-sub">{c.sub}</p>
    <div class="cta-actions">
      <a href={t.site.appUrl} class="btn">{c.btnPrimary}</a>
      <a href="https://github.com/seriaati/keni" target="_blank" rel="noopener" class="text-link">{c.btnSecondary}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-top: clamp(96px, 12vw, 160px);
  }

  .cta-title {
    font-family: var(--f-serif);
    font-size: clamp(41px, 5.5vw, 67px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.005em;
    color: var(--ink);
    text-wrap: balance;
    max-width: 18ch;
  }

  .cta-sub {
    margin-top: 20px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--mute);
    max-width: 60ch;
    text-wrap: pretty;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 36px;
  }

  :lang(zh-TW) .cta-title {
    letter-spacing: 0;
  }
</style>
