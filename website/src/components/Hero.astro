---
import type { Translations } from "../i18n/index.ts";
interface Props { t: Translations }
const { t } = Astro.props;
const h = t.hero;
---

<section class="hero">
  <div class="wrap">
    <div
      class="gloss hero-gloss"
      role="img"
      aria-label={h.exampleLabel}
      data-examples={JSON.stringify(h.examples)}
      data-filled-label={h.filledLabel}
      data-filled-separator={h.filledSeparator}
    >
      <div class="hero-line-box">
        <div class="gloss-line" aria-hidden="true">{h.examples[0].text}</div>
      </div>
      <div class="gloss-notes" aria-hidden="true"></div>
    </div>
    <p class="hero-filled" aria-hidden="true"></p>

    <div class="hero-foot">
      <h1>{h.headline}</h1>
      <p class="hero-sub">{h.sub}</p>
      <div class="hero-actions">
        <a href={t.site.appUrl} class="btn">{h.ctaPrimary}</a>
        <button type="button" class="demo-open" aria-haspopup="dialog">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="12" cy="12" r="9.25" /><path d="M10 8.6v6.8l5.4-3.4z" fill="currentColor" stroke="none" />
          </svg>
          {h.watchDemo}
        </button>
      </div>
    </div>
  </div>
</section>

<dialog class="demo" aria-label={h.demoLabel}>
  <button type="button" class="demo-close" aria-label={h.demoClose}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12" />
    </svg>
  </button>
  <video class="demo-video" src="https://share.seria.moe/demo.mp4" controls playsinline preload="none"></video>
</dialog>

<script>
  // Demo video: a native <dialog> gives focus trapping and Escape handling for free.
  const dialog = document.querySelector<HTMLDialogElement>("dialog.demo");
  const video = dialog?.querySelector("video");
  if (dialog && video) {
    const close = () => dialog.close();
    document.querySelector(".demo-open")?.addEventListener("click", () => {
      dialog.showModal();
      video.play().catch(() => {});
    });
    dialog.querySelector(".demo-close")?.addEventListener("click", close);
    dialog.addEventListener("click", (e) => { if (e.target === dialog) close(); });
    dialog.addEventListener("close", () => { video.pause(); video.currentTime = 0; });
  }
</script>

<script>
  import { Gloss, wait, reduced, type GlossExample } from "../scripts/gloss.ts";

  type HeroExample = GlossExample & { filled: [string, string][] };

  const root = document.querySelector<HTMLElement>(".hero-gloss");
  const filledEl = document.querySelector<HTMLElement>(".hero-filled");

  if (root && filledEl) {
    const examples: HeroExample[] = JSON.parse(root.dataset.examples ?? "[]");
    const filledLabel = root.dataset.filledLabel ?? "";
    const separator = root.dataset.filledSeparator ?? ", ";
    const gloss = new Gloss(root);
    let current: { ex: HeroExample; placed: ReturnType<Gloss["paint"]> } | null = null;

    const setFilled = (ex: HeroExample | null) => {
      filledEl.textContent = "";
      if (!ex) return;
      const label = document.createElement("span");
      label.textContent = filledLabel;
      const list = document.createElement("span");
      ex.filled.forEach(([kind, value], i) => {
        if (i) list.append(separator);
        const em = document.createElement("em");
        em.textContent = value;
        list.append(`${kind} `, em);
      });
      filledEl.append(label, list);
    };

    // Typing pauses while the tab is hidden so the loop does not burn cycles in the background.
    const visible = async () => {
      while (document.hidden) await wait(500);
    };

    const play = async () => {
      for (let n = 0; ; n++) {
        const ex = examples[n % examples.length];
        const chars = [...ex.text];
        for (let i = 1; i <= chars.length; i++) {
          await visible();
          gloss.paint(chars.slice(0, i).join(""), null, true);
          await wait(reduced() ? 0 : 48 + Math.random() * 46);
        }
        await wait(380);
        current = { ex, placed: gloss.paint(ex.text, ex.notes, true) };
        gloss.annotate(current.placed);
        setFilled(ex);
        await wait(4600);
        current = null;
        gloss.clear();
        setFilled(null);
        for (let i = chars.length; i >= 0; i--) {
          gloss.paint(chars.slice(0, i).join(""), null, true);
          await wait(reduced() ? 0 : 14);
        }
        await wait(260);
      }
    };

    addEventListener("resize", () => {
      if (current) {
        current.placed = gloss.paint(current.ex.text, current.ex.notes, true);
        gloss.annotate(current.placed, false);
      } else gloss.fit();
    });

    (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => {
      gloss.paint("", null, true);
      play();
    });
  }
</script>

<style>
  /* The hero fills the first screen below the header and has a fixed height: the typing loop
     changes the line and its labels, so every part inside reserves its space up front and the
     sections below never move. */
  .hero {
    height: max(600px, calc(100svh - var(--header-h)));
  }

  .hero > .wrap {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: clamp(24px, 6vh, 72px);
  }

  .hero-line-box {
    height: calc(1.12 * clamp(38px, 7.6vw, 108px));
    display: flex;
    align-items: flex-end;
  }

  .hero-gloss :global(.gloss-notes) {
    height: 172px !important;
    transition: none;
  }

  .hero-filled {
    font: 400 12.5px/1.5 var(--f-mono);
    color: var(--mute);
    height: 3em;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 4px 14px;
  }

  .hero-filled :global(em) {
    font-style: normal;
    color: var(--ink);
  }

  .hero-foot {
    margin-top: clamp(16px, 4vh, 48px);
    display: grid;
    gap: 18px;
    max-width: 620px;
  }

  h1 {
    font: 600 clamp(26px, 3.1vw, 38px)/1.08 var(--f-sans);
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  :lang(zh-TW) h1 {
    letter-spacing: 0;
    line-height: 1.25;
  }

  .hero-sub {
    font-size: 17px;
    line-height: 1.55;
    color: var(--mute);
    max-width: 54ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    align-items: center;
    margin-top: 10px;
  }

  .demo-open {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: var(--ink);
    padding-block: 12px;
    transition: color 0.2s;
  }

  .demo-open svg {
    color: var(--amber);
  }

  .demo-open:hover {
    color: var(--amber-text);
  }

  .demo {
    margin: auto;
    width: min(960px, calc(100vw - 32px));
    max-height: calc(100svh - 32px);
    border: 0;
    border-radius: var(--radius);
    background: #000;
    overflow: hidden;
    padding: 0;
  }

  .demo::backdrop {
    background: oklch(12% 0.01 70 / 0.72);
    backdrop-filter: blur(4px);
  }

  .demo[open] {
    animation: demo-in 0.3s var(--ease);
  }

  @keyframes demo-in {
    from { opacity: 0; transform: translateY(10px) scale(0.98); }
  }

  .demo-video {
    display: block;
    width: 100%;
    max-height: calc(100svh - 32px);
  }

  .demo-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: oklch(97% 0.012 85);
    background: oklch(12% 0.01 70 / 0.6);
    transition: background-color 0.2s;
  }

  .demo-close:hover {
    background: oklch(12% 0.01 70 / 0.85);
  }
</style>
