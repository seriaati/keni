---
import type { Translations } from "../i18n/index.ts";
interface Props { t: Translations }
const { t } = Astro.props;
const s = t.support;
---

<article class="support">
  <div class="wrap">
    <div class="support-inner">
      <header class="support-header">
        <p class="label">{s.eyebrow}</p>
        <h1 class="support-title">{s.title}</h1>
        <p class="support-intro">{s.intro}</p>
      </header>

      <ul class="support-list">
        {
          s.channels.map((c) => (
            <li class="support-item">
              <p class="label">{c.label}</p>
              <a href={c.href} target="_blank" rel="noopener" class="support-link">{c.value}</a>
              <p class="support-note">{c.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</article>

<style>
  .support {
    padding-top: clamp(56px, 8vw, 104px);
  }

  .support-inner {
    max-width: 700px;
  }

  .support-header {
    margin-bottom: clamp(40px, 5vw, 56px);
  }

  .support-title {
    margin-top: 16px;
    font-family: var(--f-serif);
    font-size: clamp(48px, 6vw, 72px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.005em;
    color: var(--ink);
    text-wrap: balance;
  }

  .support-intro {
    margin-top: 20px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--mute);
    max-width: 60ch;
    text-wrap: pretty;
  }

  .support-list {
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .support-item {
    padding-block: 26px;
    border-bottom: 1px solid var(--rule);
  }

  .support-link {
    display: inline-block;
    margin-top: 10px;
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
    transition: text-decoration-color 0.2s;
  }

  .support-link:hover {
    text-decoration-color: var(--amber);
  }

  .support-note {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--mute);
    max-width: 60ch;
  }

  :lang(zh-TW) .support-title,
  :lang(zh-TW) .support-link {
    letter-spacing: 0;
  }
</style>
