---
import type { Translations } from "../i18n/index.ts";
import Icon, { type IconName } from "./Icon.astro";
import ReceiptDemo from "./ReceiptDemo.astro";
import ShortcutText from "./ShortcutText.astro";
import VoiceDemo from "./VoiceDemo.astro";
interface Props { t: Translations }
const { t } = Astro.props;
const f = t.features;
const { capture, organize, connect } = f;
// Columns hidden on narrow screens: Date, Tags, Wallet.
const narrowHidden = new Set([0, 3, 4]);
const amountCol = organize.ledgerHead.length - 1;
// Icons follow item order in the copy.
const captureIcons: Record<string, IconName> = { receipt: "receipt", voice: "mic" };
const organizeIcons: IconName[] = ["tag", "wallet", "gauge", "dashboard"];
const connectIcons: IconName[] = ["chat", "key", "plug"];
---

<section id="features" class="features">
  <div class="wrap">
    <header class="head reveal">
      <p class="label">{f.label}</p>
      <h2 class="title">{f.title}</h2>
      <p class="sub">{f.sub}</p>
    </header>

    <!-- Capture: text beside a glossed example of the input -->
    <div class="group">
      <header class="group-head reveal">
        <p class="label">{capture.label}</p>
        <h3 class="group-title">{capture.title}</h3>
      </header>

      <div class="cap-list">
        {capture.items.map((item) => (
          <article class="cap-row reveal">
            <div class="cap-text">
              {captureIcons[item.kind] && <Icon name={captureIcons[item.kind]} class="item-icon" />}
              <h4 class="item-title"><ShortcutText text={item.title} /></h4>
              <p class="item-body"><ShortcutText text={item.body} /></p>
            </div>
            <figure class="cap-example">
              <figcaption class="cap-source"><ShortcutText text={item.source} /></figcaption>
              {item.kind === "receipt" && <ReceiptDemo item={item} />}
              {item.kind === "voice" && <VoiceDemo item={item} />}
              {item.kind === "command" && item.example && (
                <div class="gloss gloss--sm" data-gloss-example={JSON.stringify(item.example)}>
                  <div class="gloss-line">{item.example.text}</div>
                  <div class="gloss-notes" aria-hidden="true"></div>
                </div>
              )}
            </figure>
          </article>
        ))}
      </div>
    </div>

    <!-- Organize: a small ledger, a budget line, then a two-column text grid -->
    <div class="group">
      <header class="group-head reveal">
        <p class="label">{organize.label}</p>
        <h3 class="group-title">{organize.title}</h3>
      </header>

      <div class="ledger-block reveal">
        <table class="ledger">
          <caption class="label">{organize.ledgerCaption}</caption>
          <thead>
            <tr>
              {organize.ledgerHead.map((h, i) => (
                <th scope="col" class:list={[{ "is-narrow-hidden": narrowHidden.has(i), num: i === amountCol }]}>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {organize.ledger.map((row) => (
              <tr>
                <td class="is-narrow-hidden date">{row[0]}</td>
                <td class="desc">{row[1]}</td>
                <td class="cat">{row[2]}</td>
                <td class="is-narrow-hidden tag">{row[3] ? `#${row[3]}` : ""}</td>
                <td class="is-narrow-hidden wallet">{row[4]}</td>
                <td class="num">{row[5]}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="budget">
          <div class="budget-meta">
            <span class="budget-label">{organize.budget.label}</span>
            <span class="budget-text">{organize.budget.text}</span>
          </div>
          <div
            class="budget-track"
            role="meter"
            aria-label={organize.budget.label}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={organize.budget.percent}
            aria-valuetext={organize.budget.text}
          >
            <div class="budget-fill" style={`width: ${organize.budget.percent}%`}></div>
          </div>
        </div>
      </div>

      <div class="text-grid text-grid--2">
        {organize.items.map((item, i) => (
          <div class="text-item reveal">
            <Icon name={organizeIcons[i]} class="item-icon" />
            <h4 class="item-title">{item.title}</h4>
            <p class="item-body">{item.body}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Connect: a question and its answer, then a three-column text grid -->
    <div class="group">
      <header class="group-head reveal">
        <p class="label">{connect.label}</p>
        <h3 class="group-title">{connect.title}</h3>
      </header>

      <div class="chat reveal">
        <p class="chat-q"><span class="chat-prompt" aria-hidden="true">›</span>{connect.chat.question}</p>
        <p class="chat-a">{connect.chat.answer}</p>
      </div>

      <div class="text-grid text-grid--3">
        {connect.items.map((item, i) => (
          <div class="text-item reveal">
            <Icon name={connectIcons[i]} class="item-icon" />
            <h4 class="item-title">{item.title}</h4>
            <p class="item-body">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { Gloss, reduced, type GlossExample } from "../scripts/gloss.ts";

  type Entry = {
    g: Gloss;
    ex: GlossExample;
    placed: ReturnType<Gloss["paint"]>;
    shown: boolean;
  };

  const roots = Array.from(document.querySelectorAll<HTMLElement>("[data-gloss-example]"));

  async function start() {
    if (!roots.length) return;
    await document.fonts.ready;

    const entries = new Map<Element, Entry>();
    for (const root of roots) {
      const ex = JSON.parse(root.dataset.glossExample ?? "{}") as GlossExample;
      // 14px floor so long lines still fit narrow columns without horizontal scroll.
      const g = new Gloss(root, 14);
      entries.set(root, { g, ex, placed: g.paint(ex.text, ex.notes), shown: false });
    }

    const io = new IntersectionObserver(
      (records) => {
        for (const r of records) {
          if (!r.isIntersecting) continue;
          const e = entries.get(r.target);
          if (!e) continue;
          e.shown = true;
          e.g.annotate(e.placed, !reduced());
          io.unobserve(r.target);
        }
      },
      { threshold: 0.6, rootMargin: "0px 0px -10% 0px" },
    );
    roots.forEach((root) => io.observe(root));

    let lastWidth = window.innerWidth;
    let timer = 0;
    window.addEventListener("resize", () => {
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        for (const e of entries.values()) {
          e.placed = e.g.paint(e.ex.text, e.ex.notes);
          if (e.shown) e.g.annotate(e.placed, false);
        }
      }, 120);
    });
  }

  start();
</script>

<style>
  .features {
    padding-top: clamp(96px, 12vw, 160px);
  }

  /* ── Section header ── */

  .head {
    max-width: 760px;
  }
  .title {
    margin-top: 18px;
    font: 600 clamp(30px, 3.6vw, 42px)/1.08 var(--f-sans);
    letter-spacing: -0.028em;
    color: var(--ink);
    text-wrap: balance;
  }
  .sub {
    margin-top: 20px;
    max-width: 56ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--mute);
  }

  /* ── Groups ── */

  .group {
    margin-top: clamp(72px, 10vw, 128px);
  }
  .group-head {
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .group-title {
    margin-top: 14px;
    font: 600 clamp(22px, 2.4vw, 28px)/1.15 var(--f-sans);
    letter-spacing: -0.028em;
    color: var(--ink);
    text-wrap: balance;
  }

  .item-icon {
    display: block;
    color: var(--amber-text);
    margin-bottom: 14px;
  }

  .item-title {
    font: 600 19px/1.3 var(--f-sans);
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: balance;
  }
  .item-body {
    margin-top: 10px;
    max-width: 56ch;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--mute);
  }

  /* ── Capture ── */

  .cap-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
    padding-block: clamp(36px, 5vw, 56px);
    border-top: 1px solid var(--rule);
  }
  .cap-row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .cap-text {
    padding-top: 6px;
  }
  .cap-example {
    min-width: 0;
    overflow-x: clip;
  }
  .cap-source {
    margin-bottom: 14px;
    font: 500 11px/1.3 var(--f-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--mute);
  }

  /* Without JS the line wraps as plain text and no notes space is reserved. */
  :global(html:not(.js)) .cap-example .gloss-line {
    white-space: normal;
  }
  :global(html:not(.js)) .cap-example .gloss-notes {
    display: none;
  }

  /* ── Organize ── */

  .ledger-block {
    max-width: 880px;
  }
  .ledger {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .ledger caption {
    caption-side: top;
    text-align: left;
    padding-bottom: 16px;
  }
  .ledger th {
    padding: 0 16px 12px 0;
    text-align: left;
    font: 500 10.5px/1.3 var(--f-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--mute);
    border-bottom: 1px solid var(--rule);
    white-space: nowrap;
  }
  .ledger td {
    padding: 14px 16px 14px 0;
    font-size: 15.5px;
    line-height: 1.4;
    color: var(--ink-mid);
    border-bottom: 1px solid var(--rule);
    vertical-align: baseline;
  }
  .ledger th:last-child,
  .ledger td:last-child {
    padding-right: 0;
  }
  .ledger .num {
    text-align: right;
    white-space: nowrap;
  }
  .ledger td.num {
    color: var(--ink);
    font-weight: 500;
  }
  .ledger .date,
  .ledger .tag,
  .ledger .wallet {
    color: var(--mute);
    white-space: nowrap;
  }
  .ledger .cat {
    color: var(--ink);
  }

  .budget {
    margin-top: 32px;
    max-width: 420px;
  }
  .budget-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-size: 15px;
  }
  .budget-label {
    color: var(--ink);
  }
  .budget-text {
    color: var(--mute);
    font-variant-numeric: tabular-nums;
  }
  .budget-track {
    margin-top: 10px;
    height: 3px;
    border-radius: 2px;
    background: var(--rule);
    overflow: hidden;
  }
  .budget-fill {
    height: 100%;
    border-radius: 2px;
    background: var(--amber);
    transform-origin: left;
    transition: transform 1.2s var(--ease) 0.35s;
  }
  :global(.js) .budget-fill {
    transform: scaleX(0);
  }
  :global(.js) .ledger-block.is-visible .budget-fill {
    transform: none;
  }

  /* ── Text grids (organize and connect) ── */

  .text-grid {
    display: grid;
    gap: 44px clamp(32px, 5vw, 72px);
    margin-top: clamp(56px, 7vw, 88px);
  }
  .text-grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 960px;
  }
  .text-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  /* ── Connect ── */

  .chat {
    max-width: 760px;
  }
  .chat-q {
    display: flex;
    gap: 12px;
    font: 400 14px/1.5 var(--f-mono);
    color: var(--ink-mid);
  }
  .chat-prompt {
    color: var(--amber-text);
    font-weight: 500;
  }
  .chat-a {
    margin-top: 18px;
    max-width: 40ch;
    font: 500 clamp(21px, 2.3vw, 26px)/1.4 var(--f-sans);
    letter-spacing: -0.018em;
    color: var(--ink);
    text-wrap: pretty;
  }

  /* ── CJK: no negative tracking ── */

  .title:lang(zh-TW),
  .group-title:lang(zh-TW),
  .item-title:lang(zh-TW),
  .chat-a:lang(zh-TW) {
    letter-spacing: 0;
  }
  .item-body:lang(zh-TW),
  .sub:lang(zh-TW) {
    line-height: 1.75;
  }
  .chat-a:lang(zh-TW) {
    max-width: 28em;
  }

  /* ── Responsive ── */

  @media (max-width: 760px) {
    .cap-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .cap-text {
      padding-top: 0;
    }
    .text-grid--2,
    .text-grid--3 {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
  }

  @media (max-width: 640px) {
    .ledger .is-narrow-hidden {
      display: none;
    }
    .ledger td {
      font-size: 15px;
    }
  }
</style>
