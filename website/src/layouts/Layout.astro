---
import "../styles/global.css";
import logoSrc from "../assets/logo.svg?url";
import { getTranslations } from "../i18n/index.ts";

const locale = Astro.currentLocale ?? 'en';
const t = getTranslations(locale);
const altLocale = locale === 'zh-TW' ? 'en' : 'zh-TW';
const enPath = locale === 'zh-TW' ? Astro.url.pathname.replace(/^\/zh-TW/, '') || '/' : Astro.url.pathname;
const zhPath = `/zh-TW${enPath}`;
const altHref = locale === 'zh-TW' ? enPath : zhPath;
const altLabel = locale === 'zh-TW' ? 'EN' : '中文';
const homeHref = locale === 'zh-TW' ? '/zh-TW/' : '/';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const {
  title = t.site.title,
  description = t.site.description,
  ogImage = "/og-image.png",
  ogImageWidth = 1200,
  ogImageHeight = 630,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, "https://keni.seria.moe").href;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : `https://keni.seria.moe${ogImage}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Keni",
  "url": "https://keni.seria.moe",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
  },
  "description": description,
  "featureList": [
    "AI-powered transaction logging",
    "Receipt and invoice scanning",
    "Voice input",
    "Multiple wallets",
    "Budget tracking",
    "MCP and REST API",
    "Self-hosted",
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#3d6b4f" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={`https://keni.seria.moe${enPath}`} />
    <link rel="alternate" hreflang="zh-TW" href={`https://keni.seria.moe${zhPath}`} />
    <link rel="alternate" hreflang="x-default" href={`https://keni.seria.moe${enPath}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Keni" />
    <meta property="og:locale" content={locale === 'zh-TW' ? 'zh_TW' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:alt" content={`${title} preview image`} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <title>{title}</title>

    <script is:inline>
      // Theme: 'light' | 'dark' stored in localStorage 'keni-theme' (absent = system), same as the app.
      // Runs before first paint so there is no flash of the wrong theme.
      (() => {
        const KEY = "keni-theme";
        const NEXT = { light: "dark", dark: "system", system: "light" };
        const root = document.documentElement;
        const systemDark = matchMedia("(prefers-color-scheme: dark)");

        let pref = "system";
        try {
          const v = localStorage.getItem(KEY);
          if (v === "light" || v === "dark") pref = v;
        } catch {}

        function syncToggles() {
          document.querySelectorAll(".theme-toggle").forEach((btn) => {
            const label = btn.dataset[`label${pref[0].toUpperCase()}${pref.slice(1)}`];
            btn.title = label;
            btn.setAttribute("aria-label", label);
          });
        }

        function apply() {
          root.dataset.themePref = pref;
          root.dataset.theme = pref === "system" ? (systemDark.matches ? "dark" : "light") : pref;
          syncToggles();
        }

        apply();
        // Follow the OS setting live while on 'system'
        systemDark.addEventListener("change", apply);
        document.addEventListener("DOMContentLoaded", syncToggles);
        document.addEventListener("click", (e) => {
          if (!e.target.closest(".theme-toggle")) return;
          pref = NEXT[pref];
          try {
            if (pref === "system") localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, pref);
          } catch {}
          apply();
        });
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header site-header--enter">
      <nav class="nav-inner">
        <a href="/" class="nav-logo">
          <img src={logoSrc} alt="" width="22" height="22" />
          <span>{t.nav.logo}</span>
        </a>
        <div class="nav-links">
          <a href={`${homeHref}#features`}>{t.nav.features}</a>
          <a href={`${homeHref}#privacy`}>{t.nav.privacy}</a>
          <a href="https://github.com/seriaati/keni" target="_blank" rel="noopener">GitHub</a>
        </div>
        <a href={altHref} class="nav-lang" hreflang={altLocale}>{altLabel}</a>
        <button
          type="button"
          class="theme-toggle"
          data-label-light={t.nav.themeLight}
          data-label-dark={t.nav.themeDark}
          data-label-system={t.nav.themeSystem}
        >
          <svg class="theme-icon theme-icon--light" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <svg class="theme-icon theme-icon--dark" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
          <svg class="theme-icon theme-icon--system" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
          </svg>
        </button>
        <a href={t.site.appUrl} class="nav-cta">{t.nav.cta}</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img src={logoSrc} alt="" width="18" height="18" />
          <span>{t.footer.brand}</span>
        </div>
        <p class="footer-copy">{t.footer.tagline}</p>
        <div class="footer-links">
          <a href={`${homeHref}privacy/`} class="footer-link">{t.footer.privacyPolicy}</a>
          <a href={`${homeHref}support/`} class="footer-link">{t.footer.support}</a>
          <a href="https://github.com/seriaati/keni" target="_blank" rel="noopener" class="footer-link">GitHub</a>
        </div>
      </div>
    </footer>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
      );

      document.querySelectorAll(".reveal, .reveal-scale").forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in oklch, var(--cream) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--cream-darker);
    transition: box-shadow 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .site-header--enter {
    animation: navEnter 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes navEnter {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
    height: 56px;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--ink);
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    flex: 1;
  }

  .nav-links a {
    font-size: 14px;
    color: var(--ink-light);
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .nav-lang {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-light);
    border: 1px solid var(--cream-darker);
    padding: 7px 16px;
    border-radius: var(--radius);
    transition: color 0.15s, border-color 0.15s;
    flex-shrink: 0;
  }

  .nav-lang:hover {
    color: var(--ink);
    border-color: var(--ink-light);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--ink-light);
    border: 1px solid var(--cream-darker);
    border-radius: var(--radius);
    transition: color 0.15s, border-color 0.15s;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--ink-light);
  }

  /* Icon follows the stored preference set on <html> by the head script */
  .theme-icon {
    display: none;
  }

  :global(:root[data-theme-pref="light"]) .theme-icon--light,
  :global(:root[data-theme-pref="dark"]) .theme-icon--dark,
  :global(:root[data-theme-pref="system"]) .theme-icon--system {
    display: block;
  }

  .nav-cta {
    font-size: 13px;
    font-weight: 500;
    color: var(--cream);
    background: var(--forest);
    padding: 7px 16px;
    border-radius: var(--radius);
    transition:
      opacity 0.15s,
      transform 0.15s cubic-bezier(0.25, 1, 0.5, 1);
    flex-shrink: 0;
  }

  .nav-cta:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .nav-cta:active {
    transform: translateY(0) scale(0.97);
    transition-duration: 0.08s;
  }

  .site-footer {
    border-top: 1px solid var(--cream-darker);
    padding: 32px clamp(20px, 5vw, 48px);
    margin-top: 80px;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 16px;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--ink);
  }

  .footer-copy {
    font-size: 13px;
    color: var(--ink-faint);
  }

  .footer-links {
    display: flex;
    gap: 20px;
  }

  .footer-link {
    font-size: 13px;
    color: var(--ink-light);
    transition: color 0.15s;
  }

  .footer-link:hover {
    color: var(--ink);
  }

  @media (max-width: 600px) {
    .nav-links {
      display: none;
    }

    .nav-inner {
      gap: 8px;
    }

    .nav-lang {
      margin-left: auto;
    }
  }
</style>
