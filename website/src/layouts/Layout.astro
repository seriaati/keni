---
import "../styles/global.css";
import { getTranslations } from "../i18n/index.ts";

const locale = Astro.currentLocale ?? 'en';
const t = getTranslations(locale);
const altLocale = locale === 'zh-TW' ? 'en' : 'zh-TW';
const enPath = locale === 'zh-TW' ? Astro.url.pathname.replace(/^\/zh-TW/, '') || '/' : Astro.url.pathname;
const zhPath = `/zh-TW${enPath}`;
const altHref = locale === 'zh-TW' ? enPath : zhPath;
const altLabel = locale === 'zh-TW' ? 'EN' : '中文';
const homeHref = locale === 'zh-TW' ? '/zh-TW/' : '/';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const {
  title = t.site.title,
  description = t.site.description,
  ogImage = "/og-image.png",
  ogImageWidth = 1200,
  ogImageHeight = 630,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, "https://keni.seria.moe").href;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : `https://keni.seria.moe${ogImage}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Keni",
  "url": "https://keni.seria.moe",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
  },
  "description": description,
  "featureList": [
    "AI-powered transaction logging",
    "Receipt and invoice scanning",
    "Voice input",
    "Multiple wallets",
    "Budget tracking",
    "MCP and REST API",
    "Self-hosted",
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f4ec" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17130f" />
    <meta name="theme-color" content="#F9F5EC" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={`https://keni.seria.moe${enPath}`} />
    <link rel="alternate" hreflang="zh-TW" href={`https://keni.seria.moe${zhPath}`} />
    <link rel="alternate" hreflang="x-default" href={`https://keni.seria.moe${enPath}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Keni" />
    <meta property="og:locale" content={locale === 'zh-TW' ? 'zh_TW' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:alt" content={`${title} preview image`} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@400..700&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif&display=swap" />

    <script is:inline>
      // Theme: 'light' | 'dark' stored in localStorage 'keni-theme' (absent = system), same as the app.
      // Runs before first paint so there is no flash of the wrong theme.
      (() => {
        const KEY = "keni-theme";
        const NEXT = { light: "dark", dark: "system", system: "light" };
        const root = document.documentElement;
        root.classList.add("js");
        // Shortcut hints show ⌘ on Apple platforms, Ctrl elsewhere (see ShortcutText)
        if (/Mac|iPhone|iPad|iPod/.test(navigator.platform)) root.dataset.mac = "";
        const systemDark = matchMedia("(prefers-color-scheme: dark)");

        let pref = "system";
        try {
          const v = localStorage.getItem(KEY);
          if (v === "light" || v === "dark") pref = v;
        } catch {}

        function syncToggles() {
          document.querySelectorAll(".theme-toggle").forEach((btn) => {
            const label = btn.dataset[`label${pref[0].toUpperCase()}${pref.slice(1)}`];
            btn.title = label;
            btn.setAttribute("aria-label", label);
          });
        }

        function apply() {
          root.dataset.themePref = pref;
          root.dataset.theme = pref === "system" ? (systemDark.matches ? "dark" : "light") : pref;
          syncToggles();
        }

        apply();
        // Follow the OS setting live while on 'system'
        systemDark.addEventListener("change", apply);
        document.addEventListener("DOMContentLoaded", syncToggles);
        document.addEventListener("click", (e) => {
          if (!e.target.closest(".theme-toggle")) return;
          pref = NEXT[pref];
          try {
            if (pref === "system") localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, pref);
          } catch {}
          apply();
        });
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="k-glyph" viewBox="164 92 200 328">
        <path fill="currentColor" d="M352.964 92.9746V101.736C346.827 103.91 340.277 108.216 333.316 114.654C326.328 121.092 319.008 131.516 311.356 145.927L257.392 249.081L274.051 210.901L342.323 381.716C345.007 388.751 347.876 394.421 350.932 398.727C354.014 403.034 358.039 406.721 363.008 409.791V419C356.312 418.403 348.846 418.02 340.609 417.849C332.399 417.679 324.946 417.593 318.251 417.593C314.212 417.593 309.323 417.679 303.584 417.849C297.845 418.02 290.578 418.403 281.783 419V409.791C289.621 409.194 294.364 407.425 296.011 404.483C297.632 401.584 296.915 396.447 293.859 389.071L252.251 280.865C249.567 273.787 247.176 268.501 245.077 265.005C242.951 261.466 240.839 258.993 238.74 257.586C236.641 256.222 233.864 255.391 230.41 255.092V245.435C238.833 245.094 246.352 241.406 252.968 234.372C259.557 227.294 266.771 216.551 274.609 202.14L291.548 169.461C298.828 155.647 303.079 143.752 304.301 133.776C305.55 123.799 304.315 116.04 300.595 110.497C296.848 104.955 291.149 102.034 283.497 101.736V92.9746C290.591 93.3157 297.34 93.6354 303.743 93.9339C310.147 94.2323 317.56 94.3816 325.982 94.3816C337.089 94.3816 346.083 93.9126 352.964 92.9746ZM253.685 92.9746V102.184C247.548 102.525 242.898 103.676 239.736 105.637C236.601 107.641 234.555 111.329 233.598 116.701C232.642 122.073 232.164 130.45 232.164 141.834V370.205C232.164 381.247 232.682 389.54 233.718 395.082C234.781 400.582 236.84 404.249 239.895 406.082C242.951 407.958 247.548 409.194 253.685 409.791V419C248.504 418.403 241.994 418.02 234.156 417.849C226.318 417.679 218.374 417.593 210.323 417.593C201.156 417.593 192.508 417.679 184.377 417.849C176.247 418.02 169.79 418.403 165.008 419V409.791C171.119 409.194 175.702 407.958 178.758 406.082C181.84 404.249 183.899 400.582 184.935 395.082C185.998 389.54 186.529 381.247 186.529 370.205V141.834C186.529 130.45 185.998 122.073 184.935 116.701C183.899 111.329 181.8 107.641 178.638 105.637C175.476 103.676 170.933 102.525 165.008 102.184V92.9746C169.79 93.3157 176.247 93.6354 184.377 93.9339C192.508 94.2323 201.156 94.3816 210.323 94.3816C218.374 94.3816 226.318 94.2323 234.156 93.9339C241.994 93.6354 248.504 93.3157 253.685 92.9746Z"/>
      </symbol>
    </svg>

    <header class="site-header">
      <nav class="wrap nav">
        <a href={homeHref} class="brand">
          <svg width="12" height="20" aria-hidden="true"><use href="#k-glyph" /></svg>
          <span>{t.nav.logo}</span>
        </a>
        <div class="nav-links">
          <a href={`${homeHref}#features`}>{t.nav.features}</a>
          <a href={`${homeHref}#privacy`}>{t.nav.privacy}</a>
          <a href="https://github.com/seriaati/keni" target="_blank" rel="noopener">GitHub</a>
        </div>
        <div class="nav-tools">
          <a href={altHref} class="nav-lang" hreflang={altLocale}>{altLabel}</a>
          <button
            type="button"
            class="theme-toggle"
            data-label-light={t.nav.themeLight}
            data-label-dark={t.nav.themeDark}
            data-label-system={t.nav.themeSystem}
          >
            <svg class="theme-icon theme-icon--light" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="theme-icon theme-icon--dark" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
            </svg>
            <svg class="theme-icon theme-icon--system" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" />
            </svg>
          </button>
          <a href={t.site.appUrl} class="nav-open">{t.nav.cta}</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer">
        <a href={homeHref} class="brand">
          <svg width="10" height="17" aria-hidden="true"><use href="#k-glyph" /></svg>
          <span>{t.footer.brand}</span>
        </a>
        <p class="footer-tagline">{t.footer.tagline}</p>
        <div class="footer-links">
          <a href={`${homeHref}privacy/`}>{t.footer.privacyPolicy}</a>
          <a href={`${homeHref}support/`}>{t.footer.support}</a>
          <a href="https://github.com/seriaati/keni" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
      );

      document.querySelectorAll(".reveal").forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font: 400 25px/1 var(--f-serif);
    letter-spacing: 0;
    color: var(--ink);
  }

  .nav-links {
    display: flex;
    gap: 26px;
    flex: 1;
    font-size: 14px;
  }

  .nav-links a,
  .nav-lang {
    color: var(--mute);
    transition: color 0.2s;
  }

  .nav-links a:hover,
  .nav-lang:hover {
    color: var(--ink);
  }

  .nav-tools {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 14px;
  }

  .theme-toggle {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    color: var(--mute);
    transition: color 0.2s, background-color 0.2s;
  }

  .theme-toggle:hover {
    color: var(--ink);
    background: var(--amber-wash);
  }

  /* Icon follows the stored preference set on <html> by the head script */
  .theme-icon {
    display: none;
  }

  :global(:root[data-theme-pref="light"]) .theme-icon--light,
  :global(:root[data-theme-pref="dark"]) .theme-icon--dark,
  :global(:root[data-theme-pref="system"]) .theme-icon--system {
    display: block;
  }

  .nav-open {
    color: var(--ink);
    font-weight: 500;
  }

  .site-footer {
    margin-top: clamp(64px, 10vw, 120px);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    padding-block: 32px 40px;
    border-top: 1px solid var(--rule);
    font-size: 14px;
  }

  .footer .brand {
    font-size: 21px;
  }

  .footer-tagline {
    color: var(--mute);
    flex: 1;
  }

  .footer-links {
    display: flex;
    gap: 22px;
  }

  .footer-links a {
    color: var(--mute);
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .nav-links {
      display: none;
    }

    .nav {
      justify-content: space-between;
    }

    .nav-tools {
      gap: 12px;
    }

    .footer-tagline {
      flex-basis: 100%;
      order: 3;
    }
  }
</style>
